# At least one key — more keys enable the default multi-model pool (spread load / avoid throttles).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Or: GOOGLE_GENERATIVE_AI_API_KEY= (AI SDK default name)
XAI_API_KEY=
OPENROUTER_API_KEY=

# Optional OpenRouter attribution (recommended on their free tier)
OPENROUTER_HTTP_REFERER=https://localhost
OPENROUTER_APP_TITLE=tuhtf-swarm

# Override default pool (provider:model comma-separated). Providers: openai, google, anthropic, xai, openrouter
# AGENT_MODEL_POOL=openai:gpt-4o-mini,google:gemini-2.0-flash,anthropic:claude-3-5-haiku-20241022,xai:grok-3-mini,openrouter:meta-llama/llama-3.1-8b-instruct:free

# Local API server port (Express + npm run dev)
# AGENT_API_PORT=8788

# Stemmen voor meditaties en Gym (scripts/meditaties/*.mjs)
ELEVENLABS_API_KEY=

# M5StickC Plus2-firmware (firmware/load_env.py)
WIFI_SSID=
WIFI_PASS=
# M5_KANAAL=huiskamer-xxxx
